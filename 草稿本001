METRICS="$(curl -fsS "${CEPH_METRICS_URL}")"

TOTAL_RAW_BYTES="$(
  printf '%s\n' "$METRICS" \
    | awk '/^ceph_cluster_total_bytes(\{|[[:space:]])/ {printf "%.0f", $NF; exit}'
)"

USED_PHYSICAL_BYTES="$(
  printf '%s\n' "$METRICS" \
    | awk '/^ceph_cluster_total_used_raw_bytes(\{|[[:space:]])/ {printf "%.0f", $NF; exit}'
)"

# 如果老版本没有 ceph_cluster_total_used_raw_bytes，则兜底使用 ceph_cluster_total_used_bytes
if [ -z "$USED_PHYSICAL_BYTES" ]; then
  USED_PHYSICAL_BYTES="$(
    printf '%s\n' "$METRICS" \
      | awk '/^ceph_cluster_total_used_bytes(\{|[[:space:]])/ {printf "%.0f", $NF; exit}'
  )"
fi

HEALTH_CODE="$(
  printf '%s\n' "$METRICS" \
    | awk '/^ceph_health_status(\{|[[:space:]])/ {printf "%.0f", $NF; exit}'
)"

PRODUCT_VERSION="$(
  printf '%s\n' "$METRICS" \
    | grep -m1 -E '^ceph_(mon|mgr|osd)_metadata\{' \
    | sed -n 's/.*ceph_version="ceph version \([0-9][0-9.]*\).*/\1/p'
)"

FS_ID="$(
  printf '%s\n' "$METRICS" \
    | grep -m1 -Eo '(fsid|fs_id|cluster_fsid|ceph_fsid)="[^"]+"' \
    | sed 's/.*="//;s/"$//'
)"

jq -n \
  --arg fs_id "$FS_ID" \
  --arg operational_status "active" \
  --arg product_version "$PRODUCT_VERSION" \
  --argjson total_raw_bytes "${TOTAL_RAW_BYTES:-null}" \
  --argjson used_physical_bytes "${USED_PHYSICAL_BYTES:-null}" \
