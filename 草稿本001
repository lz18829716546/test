5. 需要继续确认哪些点
5.1 查这个 Agent 是否接管网络流量

执行：

for h in gz-4f31406-ceph-001201 gz-4f31406-ceph-001202 gz-4f31406-ceph-001203; do
  echo "==================== $h : netfilter / nfqueue check ===================="
  ssh "$h" '
    echo "[1] iptables rules"
    iptables-save 2>/dev/null | egrep -i "NFQUEUE|QUEUE|vmsec|wss|defence|secmodel|DROP|REJECT" || true

    echo
    echo "[2] nft rules"
    nft list ruleset 2>/dev/null | egrep -i "queue|vmsec|wss|defence|secmodel|drop|reject" || true

    echo
    echo "[3] nf related modules"
    lsmod | egrep -i "nfnetlink_queue|nf_conntrack|nf_queue|ip_queue|vmsec_nfq|nfq" || true

    echo
    echo "[4] agent network config"
    egrep -Rni "net|filter|queue|nfq|nfqueue|socket|tcp|connect|accept|close|listen" \
      /usr/local/wsssr_defence_agent/script \
      /usr/local/wsssr_defence_agent/vmsec-host/conf \
      /usr/local/wsssr_defence_agent/vmsec-host/file/etc \
      2>/dev/null | head -100
  '
done

如果看到 NFQUEUE、QUEUE 或 agent 的网络过滤规则，嫌疑会进一步增强。

5.2 查模块版本、编译信息、签名信息
for h in gz-4f31406-ceph-001201 gz-4f31406-ceph-001202 gz-4f31406-ceph-001203; do
  echo "==================== $h : module version / hash ===================="
  ssh "$h" '
    for f in \
      /usr/local/wsssr_defence_agent/resguard_linux.ko \
      /usr/local/wsssr_defence_agent/secmodel_linux.ko \
      /usr/local/wsssr_defence_agent/syshook_linux.ko \
      /usr/local/wsssr_defence_agent/vmsec-host/net/module/vmsec_nfq-5.4.0-144-generic.x86_64.ko \
      /usr/local/wsssr_defence_agent/vmsec-host/file/module/vmsecmod.ko
    do
      echo "---------- $f ----------"
      [ -f "$f" ] || continue
      sha256sum "$f"
      modinfo "$f" 2>/dev/null | egrep -i "filename|version|description|author|license|srcversion|vermagic|signer|sig_key|sig_hashalgo|depends|retpoline|intree" || true
      echo
    done
  '
done

这些信息后续要发给安全软件厂商确认是否有已知问题或补丁版本。
