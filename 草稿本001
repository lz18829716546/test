> #!/usr/bin/env bash
> set -euo pipefail
> 
> for mnt in /mnt/minio/disk{1..6}; do
>   dev=$(findmnt -n -o SOURCE "$mnt" || true)
>   [ -z "$dev" ] && continue
> 
>   devbase=$(basename "$dev")
>   xfs_path="/sys/fs/xfs/$devbase/error/metadata"
> 
>   if [ -d "$xfs_path" ]; then
>     echo "Set XFS retry settings for $dev mounted at $mnt"
>     echo 0 > "$xfs_path/EIO/max_retries" || true
>     echo 0 > "$xfs_path/ENOSPC/max_retries" || true
>     echo 0 > "$xfs_path/default/max_retries" || true
>   fi
> done
> EOF
