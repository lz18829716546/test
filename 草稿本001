>   NR==FNR {
>     if (NF==3) old[$1" "$2]=$3;
>     next;
>   }
>   NF==3 {
>     key=$1" "$2;
>     if (key in old) {
>       delta=$3-old[key];
>       if (delta != 0) {
>         printf "%-10s %-35s delta=%s now=%s\n", $1, $2, delta, $3;
>       }
>     }
>   }
> ' "$A" "$B"
> 
> rm -f "$A" "$B"
