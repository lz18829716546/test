# /etc/systemd/system/minio.service
[Unit]
Description=MinIO Object Storage Server
Documentation=https://min.io/docs/minio/linux/index.html
Wants=network-online.target
After=network-online.target
After=minio-xfs-retry-settings.service
RequiresMountsFor=/mnt/minio/disk1 /mnt/minio/disk2 /mnt/minio/disk3 /mnt/minio/disk4 /mnt/minio/disk5 /mnt/minio/disk6

[Service]
Type=simple
User=minio-user
Group=minio-user
EnvironmentFile=/etc/default/minio
Environment=HOME=/var/lib/minio
WorkingDirectory=/var/lib/minio

ExecStartPre=/bin/bash -c 'for d in /mnt/minio/disk{1..6}; do mountpoint -q "$d" || { echo "$d not mounted"; exit 1; }; test -w "$d" || { echo "$d not writable"; exit 1; }; done'

ExecStart=/usr/local/bin/minio server $MINIO_OPTS $MINIO_VOLUMES

Restart=always
RestartSec=5
LimitNOFILE=1048576
TasksMax=infinity
TimeoutStopSec=infinity
SendSIGKILL=no

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
