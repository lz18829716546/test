> DEVICES="$BOND $SLAVES"
> 
> snapshot() {
>   local file="$1"
>   {
>     echo "timestamp $(date '+%F_%T')"
> 
>     for dev in $DEVICES; do
>       [ -d "/sys/class/net/$dev" ] || continue
>       for k in rx_packets rx_bytes rx_errors rx_dropped rx_missed_errors rx_fifo_errors rx_crc_errors rx_frame_errors rx_length_errors tx_packets tx_bytes tx_errors tx_dropped; do
>         [ -r "/sys/class/net/$dev/statistics/$k" ] && echo "$dev sys_$k $(cat /sys/class/net/$dev/statistics/$k)"
>       done
>     done
> 
>     for dev in $SLAVES; do
>       ip link show "$dev" >/dev/null 2>&1 || continue
>       ethtool -S "$dev" 2>/dev/null | awk -v dev="$dev" '
>         {gsub(":", "", $1)}
>         $1 ~ /^(rx_packets|rx_bytes|rx_errors|rx_dropped|rx_crc_errors|rx_length_errors|rx_alloc_fail|rx_pg_alloc_fail|rx_unknown_protocol|port.rx_dropped|port.rx_crc_errors|port.rx_csum_bad|port.rx_length_errors|tx_timeout|tx_busy)$/ {
>           print dev, "eth_"$1, $2
>         }
>       '
>     done
> 
>     awk '
>       BEGIN{drop=0; squeeze=0}
>       {
>         drop += strtonum("0x"$2);
>         squeeze += strtonum("0x"$3);
>       }
>       END{
>         print "softnet softnet_dropped " drop;
>         print "softnet softnet_time_squeeze " squeeze;
>       }
>     ' /proc/net/softnet_stat
> 
>     nstat -az 2>/dev/null | awk '
>       $1 ~ /^(TcpRetransSegs|TcpOutRsts|TcpEstabResets|TcpExtListenDrops|TcpExtListenOverflows|TcpExtTCPTimeouts|TcpExtTCPAbortOnData|TcpExtTCPAbortOnClose|TcpExtTCPSynRetrans|IpInDiscards|IpOutDiscards)$/ {
>         print "nstat", $1, $2
>       }
>     '
>   } > "$file"
> }
